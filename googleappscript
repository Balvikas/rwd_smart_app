          return 0;
        }
        
        var numericMatch = str.match(/\d+/);
        if (numericMatch) {
          var num = parseInt(numericMatch, 10);
          if (num >= 1 && num <= 3)   return 1;
          if (num >= 4 && num <= 6)   return 2;
          if (num >= 7 && num <= 9)   return 3;
          if (num >= 10 && num <= 12) return 4;
        }
        return 999; 
