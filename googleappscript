        htmlOutput += "<div class='empty-state'>🎉 All students have checked out safely today!</div>";
      } else {
        htmlOutput += "<table><thead><tr><th>Student Name</th><th>Parent / Guardian</th><th>Phone Number</th><th style='text-align:right;'>Checked In</th></tr></thead><tbody>";
        for (var m = 0; m < sortedPendingGrades.length; m++) {
