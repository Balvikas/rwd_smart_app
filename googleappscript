            htmlOutput += "<tr><td style='font-weight:600;'>📍 " + hStudent.name + "</td><td style='text-align:right;'><span class='badge-in'>🟢 In: " + hStudent.checkIn + "</span> &nbsp; <span class='badge-out'>🔴 Out: " + hStudent.checkOut + "</span></td></tr>";
          }
        }
        htmlOutput += "</tbody></table>";
      }
      htmlOutput += "</div></body></html>";
return HtmlService.createHtmlOutput(htmlOutput).setTitle("Pending Check-Out Roster").setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);} catch(err) {return HtmlService.createHtmlOutput("❌ Error building timeline view: " + err.toString() + "");}
}
