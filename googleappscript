          // UPDATED HEADER LABEL: Explicitly couples both group definitions side-by-side
          htmlOutput += "<tr><td colspan='4' class='grade-section-header'>📂 " + groupLabel + " &nbsp;•&nbsp; " + pendingGradeName + " (" + pendingStudents.length + " Inside)</td></tr>";
          
